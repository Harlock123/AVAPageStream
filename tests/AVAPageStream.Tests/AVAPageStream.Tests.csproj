<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- One test reads a rendered bitmap's pixels. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The tests pass no cancellation tokens: each is quick, and none waits on anything outside. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\AVAPageStream\AVAPageStream.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sample TIFFs made by ImageMagick, one picture in each encoding the EPS preview reader takes. -->
    <None Include="Core\Samples\*.tif" CopyToOutputDirectory="PreserveNewest" />
    <!-- EPS files from real producers, each with the PNG its producer draws of the same picture to compare with. -->
    <None Include="Core\Samples\eps\*.eps;Core\Samples\eps\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Core\Samples\pdf\*.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Scanned pictures made by ImageMagick from fax.png: CCITT Group 4 in a PDF, Group 3 in a TIFF. -->
    <None Include="Core\Samples\scans\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- JPEG 2000 made by OpenJPEG (opj_compress) from src.png, each with opj_decompress's decoding of it (.ref.png). -->
    <None Include="Core\Samples\jpx\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
