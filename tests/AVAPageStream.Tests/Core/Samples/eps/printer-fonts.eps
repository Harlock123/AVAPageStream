%!PS-Adobe-3.0 EPSF-3.0
%%Creator: written by hand, as Illustrator-era files are: fonts named, not carried
%%BoundingBox: 0 0 240 90
%%DocumentNeededResources: font Times-Roman Helvetica-Bold Courier-Oblique
%%EndComments
/Times-Roman findfont 22 scalefont setfont
10 62 moveto (Harbour lamps, 1926) show
/Helvetica-Bold findfont 18 scalefont setfont
0.125 0.314 0.816 setrgbcolor
10 36 moveto (Tide tables) show
/Courier-Oblique findfont 14 scalefont setfont
0 setgray
10 12 moveto (x = f(y) + 42;) show
showpage
%%EOF
