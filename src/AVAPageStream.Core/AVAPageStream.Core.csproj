<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything but the window: the document and its objects, stories and how they flow through their frames,
       undo, snapping, units and colours, and the .avps file. -->
  <PropertyGroup>
    <RootNamespace>AVAPageStream.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Liang's hyphenation patterns for American English, read by Hyphenator. -->
    <EmbeddedResource Include="Hyphenation\*.txt" LogicalName="Hyphenation.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVAPageStream.Tests" />
  </ItemGroup>
</Project>
