<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window: the page view with its tools and rulers, the side panel, menus, and PDF and PNG export. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVAPageStream</AssemblyName>
    <RootNamespace>AVAPageStream</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AVAPageStream.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Already under Avalonia; referenced for its PDF document. Keep it at the version Avalonia.Skia asks for. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <ProjectReference Include="..\AVAPageStream.Core\AVAPageStream.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVAPageStream.Tests" />
  </ItemGroup>
</Project>
